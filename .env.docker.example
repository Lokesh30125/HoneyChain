# HoneyChain — deployment configuration for docker-compose.yml
# Copy to `.env` next to docker-compose.yml and replace every REPLACE_… value.
# `.env` is git-ignored; never commit it. The API refuses to start in
# production if any of the checked values is missing or still a development one.

# --- Public address (what users type, and what QR labels point to) ---------
FRONTEND_URL=https://REPLACE_WITH_YOUR_DOMAIN
BACKEND_URL=https://REPLACE_WITH_YOUR_DOMAIN
PUBLIC_TRACE_BASE_URL=https://REPLACE_WITH_YOUR_DOMAIN/trace
CORS_ORIGINS=https://REPLACE_WITH_YOUR_DOMAIN
HTTP_PORT=8080

# --- Database (the `db` service) --------------------------------------------
POSTGRES_DB=honeychain
POSTGRES_USER=honeychain
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD

# --- Authentication -----------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_WITH_A_64_BYTE_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=20
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Same-origin deployment (nginx serves the app and proxies /api): lax works.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
AUTH_EXPOSE_REFRESH_IN_BODY=false

# --- First administrator (created on start if both are set; remove after) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Platform Administrator
DEFAULT_ADMIN_PASSWORD=

# --- Blockchain (external service) -----------------------------------------
# Either point at the running ledger service, or switch the integration off;
# events are then recorded in HoneyChain and marked SKIPPED, never faked.
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_BASE_URL=https://REPLACE_WITH_BLOCKCHAIN_SERVICE_URL

# --- Laboratory: development overrides stay off in production --------------
LAB_ALLOW_RISK_OVERRIDE=false
LAB_DEMO_CONFIGURATION_ENABLED=false
LAB_DEMO_MEASUREMENTS_ENABLED=false

# --- IoT (optional MQTT broker; HTTP ingest works without it) --------------
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=true

# --- Logging ------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
